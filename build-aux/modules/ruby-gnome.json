{
  "name": "ruby-gnome",
  "buildsystem": "simple",
  "build-options": {
    "env": {
      "MAKEFLAGS": "-j4"
    }
  },
  "build-commands": [
    "gem install --local --no-document --verbose native-package-installer-1.1.9.gem \\\n    pkg-config-1.6.5.gem \\\n    glib2-4.3.8.gem \\\n    rake-13.4.2.gem \\\n    atk-4.3.8.gem \\\n    json-2.21.2.gem \\\n    matrix-0.4.3.gem \\\n    red-colors-0.4.0.gem \\\n    cairo-1.18.5.gem \\\n    cairo-gobject-4.3.8.gem \\\n    fiddle-1.1.8.gem \\\n    gobject-introspection-4.3.8.gem \\\n    gio2-4.3.8.gem \\\n    gdk_pixbuf2-4.3.8.gem \\\n    pango-4.3.8.gem \\\n    gdk4-4.3.8.gem \\\n    graphene1-4.3.8.gem \\\n    gsk4-4.3.8.gem \\\n    gtk4-4.3.8.gem \\\n    adwaita-4.3.8.gem",
    "install -Dm755 ruby-smoke-test.rb ${FLATPAK_DEST}/bin/workbench-ruby-smoke-test"
  ],
  "post-install": [
    "ruby -e 'require \"gobject-introspection\"; require \"gio2\"; puts \"ruby-gnome: introspection ok\"'",
    "gem list --local gtk4 adwaita gobject-introspection"
  ],
  "cleanup": [
    "/lib/ruby/gems/*/cache",
    "/lib/ruby/gems/*/doc",
    "/lib/ruby/gems/*/gems/*/test",
    "/lib/ruby/gems/*/gems/*/sample",
    "*.o"
  ],
